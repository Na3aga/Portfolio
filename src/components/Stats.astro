---
import { stats } from "~/data/site";
---

<section class="px-4 md:px-10">
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-y-12 border-t border-line pt-12 lg:grid-cols-4">
    {
      stats.map((stat, i) => (
        <div data-reveal data-reveal-delay={i * 80}>
          <dt class="display text-[clamp(3.5rem,7vw,6rem)]">{stat.value}</dt>
          <dd class="mt-3 max-w-[14rem] text-[13px] leading-relaxed text-muted">
            <span class="text-ink">{stat.unit}</span> — {stat.label}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
