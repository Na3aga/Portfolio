---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Cards without a cover get an accent-tinted plate with the project's initials.
const initials = (title: string) =>
  title
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

<Section id="work" index="05" label="Selected work" title="Projects I owned end to end">
  <ul class="grid gap-6 md:grid-cols-2 md:gap-8">
    {
      projects.map((project, i) => (
        <li data-reveal data-reveal-delay={i * 70}>
          <a href={`/work/${project.id}/`} class="project group block">
            <div class="lift relative aspect-[4/3] overflow-hidden rounded-2xl border border-line bg-surface group-hover:border-accent/50">
              {project.data.cover ? (
                <img
                  src={project.data.cover}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                />
              ) : (
                <span class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent/25 to-transparent">
                  <span class="display text-6xl text-accent/70 md:text-7xl">
                    {initials(project.data.title)}
                  </span>
                </span>
              )}

              <span class="absolute top-4 right-4 rounded-full bg-bg/80 px-3 py-1 text-[12px] font-medium backdrop-blur-sm">
                {project.data.year}
              </span>
            </div>

            <div class="mt-5 flex items-start justify-between gap-4">
              <div>
                <h3 class="text-2xl font-bold transition-colors group-hover:text-accent md:text-[28px]">
                  {project.data.title}
                </h3>
                <p class="mt-1 text-[14px] text-muted">{project.data.role}</p>
              </div>
              <span aria-hidden="true" class="mt-1 text-xl text-muted transition-all group-hover:translate-x-1 group-hover:text-accent">
                ↗
              </span>
            </div>

            <p class="mt-3 max-w-xl text-[17px] leading-relaxed text-muted">{project.data.summary}</p>

            <p class="mt-4 flex flex-wrap gap-2">
              {project.data.stack.slice(0, 5).map((tech) => (
                <span class="rounded-full border border-line px-3 py-1 text-[12px] text-muted">{tech}</span>
              ))}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
