---
import Base from "~/layouts/Base.astro";
---

<Base title="404 — Page not found">
  <section class="flex min-h-svh flex-col justify-center px-6 md:px-10">
    <div class="mx-auto w-full max-w-[1400px]">
      <h1 class="display text-mega text-accent">404</h1>
      <p class="mt-8 max-w-md text-xl leading-snug text-muted">
        That page doesn't exist — it may have moved or never been here.
      </p>
      <a href="/" class="btn mt-10">Back home</a>
    </div>
  </section>
</Base>
